# 1. UPSTASH REDIS (Free Tier: 10,000 commands/day)
# Get your free Redis credentials from https://upstash.com
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"

# 2. SUPABASE POSTGRES (Free Tier: 500 MB Postgres database)
# Get your free database credentials from https://supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# NOTE: If you do not provide these credentials, AdGuard Web will 
# automatically and seamlessly run in high-speed local in-memory RAM mode!

