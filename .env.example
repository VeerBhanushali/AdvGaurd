# ========================================================
# AdvGuard - Cloud Configuration Example
# Created & Engineered by Veer Bhanushali
# ========================================================
# ⚠️ SECURITY NOTICE: NEVER COMMIT REAL SECRETS OR .env.local TO GIT!
# Copy this file to .env.local to configure your local or production instance.
# ========================================================

# --------------------------------------------------------
# OPTION 1: SUPABASE (Recommended for DNS Analytics & Logging)
# --------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Go to "SQL Editor", paste `supabase-schema.sql` and click "Run"
# 3. Copy your Project URL & Anon Key from Settings > API:
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# Optional: Service Role key for automated 30-day log purges
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# --------------------------------------------------------
# OPTION 2: FIREBASE (Zero SQL Setup - Auto Collections)
# --------------------------------------------------------
# 1. Create a free project at https://console.firebase.google.com
# 2. Enable Firestore Database and copy your Web App credentials:
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id_here"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"

# --------------------------------------------------------
# HIGH-SECURITY & PRIVACY CONTROLS (Public Cloud Mode)
# --------------------------------------------------------
# Mask client IP addresses (Zero-PII GDPR Compliance): "true" or "false"
ANONYMIZE_IPS="true"

# Number of days to retain query logs before automated purge:
LOG_RETENTION_DAYS="30"

# Public instance mode (enforces strict DDoS rate limiting & anonymization):
PUBLIC_CLOUD_MODE="true"

# Admin Dashboard Protection (Prevents public visitors from seeing private logs or toggling settings)
ADMIN_PASSWORD="your_secret_admin_password"

# --------------------------------------------------------
# ZERO-CONFIG RAM MODE:
# --------------------------------------------------------
# Leave all variables blank and AdvGuard automatically runs in
# ultra-fast local In-Memory RAM mode with 0ms latency!
