# ========================================================
# AdvGuard – configuration template
# Copy to .env.local (local) or set in your host's environment panel.
# NEVER commit real values. Only this file is tracked by git.
# ========================================================

# --------------------------------------------------------
# ADMIN (required in production)
# --------------------------------------------------------
# Minimum 12 characters. If unset or too short, the admin dashboard is
# DISABLED in production (fail-closed). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=""

# Public hostname used in the iOS profile (prevents Host-header spoofing).
PUBLIC_HOSTNAME="advgaurd.example.com"

# --------------------------------------------------------
# NETWORK / ABUSE PROTECTION
# --------------------------------------------------------
# Reverse proxies in front of the app that append X-Forwarded-For.
# Hostinger / Vercel / single Nginx = 1 · Cloudflare + Nginx = 2 · none = 0
TRUSTED_PROXY_HOPS="1"
# Per-IP DoH query limit (sliding window, per minute)
RATE_LIMIT_PER_MINUTE="300"
# Max registered device tokens held in memory
MAX_DEVICES="1000"
# Upstream resolvers (comma-separated DoH URLs)
UPSTREAM_DOH="https://dns.quad9.net/dns-query,https://cloudflare-dns.com/dns-query"

# --------------------------------------------------------
# BLOCKLISTS
# --------------------------------------------------------
# Download HaGeZi Multi PRO at startup + daily (~25 MB RAM). Set "false" on tiny plans.
REMOTE_BLOCKLISTS="true"
# Optional: replace the default remote list(s) with your own (comma-separated https URLs)
BLOCKLIST_URLS=""

# --------------------------------------------------------
# PRIVACY
# --------------------------------------------------------
# Mask client IPs to /24 (IPv4) and /64 (IPv6) before they are logged anywhere.
# Keep "true" on any instance used by other people.
ANONYMIZE_IPS="true"
# Days to keep query logs in the database (1–365). Purged every 12 hours.
LOG_RETENTION_DAYS="30"

# --------------------------------------------------------
# DATABASE OPTION 1: SUPABASE (recommended)
# --------------------------------------------------------
# Run supabase-schema.sql in the SQL editor, then copy Settings → API.
# The SERVICE ROLE key is server-only – never prefix it with NEXT_PUBLIC_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --------------------------------------------------------
# DATABASE OPTION 2: FIREBASE FIRESTORE (write-only logs)
# --------------------------------------------------------
# Deploy firestore.rules first – it blocks all public reads.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Leave both databases blank to run in RAM-only mode (nothing persisted).
