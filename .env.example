# Single Database: SUPABASE (Free Tier: 500 MB PostgreSQL + Built-in Auth)
# 1. Create a free project at https://supabase.com
# 2. Go to "SQL Editor", paste `supabase-schema.sql` and click "Run"
# 3. Copy your Project URL & Anon Key from Settings > API:

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# NOTE: If you leave these blank, AdvGuard automatically runs in 
# high-speed local In-Memory RAM mode with zero external dependencies!
